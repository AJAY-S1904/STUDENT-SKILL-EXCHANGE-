    <style name="Theme.SkillSwapAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.SkillSwapAI.SplashScreen" parent="Theme.SplashScreen">
